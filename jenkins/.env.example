# Copiar a jenkins/.env (no se sube a GitHub)
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambiar-esta-clave
JENKINS_PORT=8080
# GID del grupo dueño de /var/run/docker.sock:  stat -c %g /var/run/docker.sock
DOCKER_GID=999
REPO_URL=https://github.com/marojasp1/IntegracionContinua_Grupo10.git
REPO_BRANCH=main
